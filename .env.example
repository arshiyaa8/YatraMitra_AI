# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/tourism_assistant

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
HEALTH_DATA_ENCRYPTION_KEY=change_this_to_a_32_char_secret_key

# ── Sarvam AI (Indic STT, Translation & TTS) ─────────
SARVAM_API_KEY=

# ── ML Microservice ─────────────────────────────────────
ML_API_URL=http://127.0.0.1:5001

# ── Bhashini (Digital India NLTM) ───────────────────────
# Register at https://bhashini.gov.in to get these
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd


# ── Weather: NASA POWER (no key needed) + IMD (adapter, optional) ─
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
# Set to "true" only once IMD reopens registrations and IMD_API_KEY is set
IMD_ENABLED=false

# ── OpenWeatherMap fallback (optional, free tier) ───────
OPENWEATHER_API_KEY=

# ── SACHET (NDMA Common Alerting Protocol) ──────────────
SACHET_CAP_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# ── Fallback / premium TTS (optional) ───────────────────
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# ── Bhuvan (ISRO geoportal, optional) ───────────────────
BHUVAN_API_KEY=

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
